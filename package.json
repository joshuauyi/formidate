{
  "name": "formidate",
  "version": "2.0.0-beta.0",
  "description": "Tiny, zero-dependency form validation for any framework (or none). Validates plain HTML forms from their attributes, with a typed rule DSL and Standard Schema (Zod, Valibot, ArkType) support.",
  "keywords": [
    "form",
    "forms",
    "validation",
    "validator",
    "form-validation",
    "html5",
    "constraint-validation",
    "standard-schema",
    "zod",
    "valibot",
    "yup",
    "arktype",
    "typescript",
    "react",
    "vue",
    "svelte",
    "vanilla"
  ],
  "homepage": "https://github.com/joshuauyi/formidate#readme",
  "bugs": {
    "url": "https://github.com/joshuauyi/formidate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuauyi/formidate.git"
  },
  "license": "MIT",
  "author": "Joshua Uyi <joshuaouyi@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/formidate.iife.js",
  "jsdelivr": "./dist/formidate.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite examples",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "arktype": "^2.2.9",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yup": "^1.7.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "core (createForm + field)",
      "path": "dist/index.js",
      "import": "{ createForm, field }",
      "limit": "9 kB"
    },
    {
      "name": "react hook",
      "path": "dist/react.js",
      "import": "{ useForm }",
      "ignore": [
        "react"
      ],
      "limit": "9 kB"
    },
    {
      "name": "CDN bundle",
      "path": "dist/formidate.iife.js",
      "limit": "9.5 kB"
    }
  ]
}
